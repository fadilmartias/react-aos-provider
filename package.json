{
    "name": "react-aos-provider",
    "version": "0.2.0",
    "description": "A lightweight, framework-agnostic AOS (Animate on Scroll) provider for React.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./styles.css": "./dist/index.css",
        "./package.json": "./package.json"
    },
    "sideEffects": [
        "*.css"
    ],
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "npm run build && changeset publish",
        "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
    },
    "keywords": [
        "react",
        "aos",
        "animate-on-scroll",
        "scroll-animation",
        "intersection-observer",
        "react-hooks"
    ],
    "author": "M. Fadil Martias",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/fadilmartias/react-aos-provider.git"
    },
    "homepage": "https://github.com/fadilmartias/react-aos-provider#readme",
    "bugs": {
        "url": "https://github.com/fadilmartias/react-aos-provider/issues"
    },
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.27.11",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.1.0",
        "@types/react": "^19.0.2",
        "@types/react-dom": "^19.0.2",
        "@typescript-eslint/eslint-plugin": "^8.19.0",
        "@typescript-eslint/parser": "^8.19.0",
        "@vitest/coverage-v8": "^4.1.10",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.1.0",
        "jsdom": "^25.0.1",
        "prettier": "^3.4.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tsup": "^8.3.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.19.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    }
}
